{
  "name": "homm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && node tools/postbuild.mjs",
    "watch": "tsc --watch",
    "start": "node tools/serve.mjs",
    "dev": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "smoke": "node tools/smoke.mjs",
    "audit:layout": "node tools/layoutaudit.mjs",
    "audit:mines": "node tools/minesaudit.mjs",
    "audit:ai": "node tools/ailayout.mjs",
    "audit:hover": "node tools/hoveraudit.mjs",
    "audit:touch": "node tools/tinytargetaudit.mjs",
    "audit:b0": "node tools/b0audit.mjs",
    "audit:atlas": "node tools/atlasaudit.mjs",
    "audit:ai-diag": "node tools/aidiagnose.mjs",
    "audit:badge": "node tools/mapbadgeaudit.mjs",
    "audit:contact": "node tools/contactaudit.mjs",
    "assets:mobile": "node tools/mobile-assets.mjs && capacitor-assets generate --android --assetPath resources --iconBackgroundColor \"#3a2a14\" --splashBackgroundColor \"#1b1f24\"",
    "mobile:sync": "npm run build && node tools/androidsync.mjs",
    "audit:scenario": "node tools/scenarioaudit.mjs",
    "audit:androidsync": "node tools/androidsync.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1"
  }
}
